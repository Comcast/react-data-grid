{
  "name": "react-data-grid",
  "version": "7.0.0-beta.63",
  "description": "Feature-rich and customizable data grid React component",
  "keywords": [
    "data grid",
    "react"
  ],
  "license": "MIT",
  "repository": "github:Comcast/react-data-grid",
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": [
    "src/index.ts",
    "**/*.css"
  ],
  "exports": {
    "./lib/styles.css": "./lib/styles.css",
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "prepare": "vp config"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.1",
    "@faker-js/faker": "^10.3.0",
    "@tanstack/react-router": "^1.166.7",
    "@tanstack/router-plugin": "^1.166.7",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "clsx": "^2.1.1",
    "ecij": "^0.6.0",
    "eslint": "^10.2.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "oxc-transform-react": "^0.155.0",
    "playwright": "^1.62.1",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "beta",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2"
  },
  "overrides": {
    "oxc-transform-react": "$oxc-transform-react",
    "typescript": "$typescript",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.2.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.12.1",
      "onFail": "download"
    }
  },
  "allowScripts": {
    "core-js": false
  }
}
